{
  "name": "silkstack",
  "description": "SilkStack Image Browser",
  "author": "skkut <github.com/skkut>",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "main": "electron/main.mjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:app": "node scripts/start-dev.js",
    "prebuild": "node -e \"require('fs').copyFileSync('docs/CHANGELOG.md', 'public/CHANGELOG.md')\"",
    "build:ai": "node scripts/build-ai-intelligence.cjs",
    "build": "npm run build:ai && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron-pack": "npm run build && electron-builder",
    "electron-dist": "npm run build && electron-builder --publish=never",
    "package-win": "npm run build && npx electron-packager . --overwrite --asar.unpack=\"**/node_modules/ffprobe-static/**\" --platform=win32 --arch=x64 --icon=public/icon.ico --prune=true --out=release-builds --ignore=\"^/(?!electron(/|$)|dist(/|$)|public(/|$)|node_modules(/|$)|package\\.json$|LICENSE$)\" --ignore=\"^/node_modules/\\.vite(/|$)\" --ignore=\"^/node_modules/\\.package-lock\\.json$\" --ignore=\"^/node_modules/ffprobe-static/bin/(darwin|linux)(/|$)\" --ignore=\"^/node_modules/ffprobe-static/bin/win32/ia32(/|$)\"",
    "release": "npm run build && electron-builder --publish=always",
    "generate-release": "node scripts/generate-release.js",
    "update-version": "node scripts/update-version.js",
    "release-workflow": "node scripts/release-workflow.js",
    "auto-release": "node scripts/auto-release.js",
    "reset-cache": "node scripts/reset-cache.js",
    "sync-changelog": "node scripts/sync-changelog.js",
    "test": "vitest",
    "cli:parse": "tsx scripts/cli.ts parse",
    "cli:index": "tsx scripts/cli.ts index",
    "comfy:parse": "tsx scripts/parse-comfy-workflow.ts",
    "comfy:batch": "tsx scripts/parse-comfy-batch.ts",
    "prompt": "tsx scripts/extract-prompt.ts"
  },
  "bin": {
    "SilkStack-cli": "./scripts/cli.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.77",
    "archiver": "^7.0.1",
    "cbor-js": "^0.1.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.1",
    "exifr": "^7.1.3",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.23.24",
    "hotkeys-js": "^3.13.15",
    "pngjs": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.10",
    "react-zoom-pan-pinch": "^3.6.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "tar": "^7.5.22",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.19",
    "form-data": "^4.0.6",
    "@xmldom/xmldom": "^0.8.15",
    "ip-address": "^10.7.2",
    "joi": "^18.2.9",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.26",
    "postcss-selector-parser": "^6.1.4",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.5.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.4",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "lightningcss": "^1.33.0",
    "lucide-react": "^0.544.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1",
    "wrangler": "^4.146.0"
  }
}
